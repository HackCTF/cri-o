# Dockerfile.build — CRI-O cross-build for AlmaLinux 10 (nervous-vaughan target)
# Uso: docker build -f hackctf/Dockerfile.build -t crio-build:hackctf .
# Luego: docker cp $(docker create crio-build:hackctf):/output/. ./output/

FROM almalinux:10 AS builder

# Instalar Go 1.23 y dependencias de build
RUN dnf install -y 'dnf-command(reposync)' && \
    dnf install -y epel-release && \
    dnf install -y \
        golang \
        device-mapper-devel \
        gpgme-devel \
        btrfs-progs-devel \
        libseccomp-devel \
        libselinux-devel \
        pkgconfig \
        make \
        git \
        go-md2man \
        iptables \
    && dnf clean all

WORKDIR /src

# Copiar código fuente
COPY . .

# BUILDTAGS: devmapper habilitado (sin exclude_graphdriver_devicemapper)
# CGO_ENABLED=1 para linkear contra libdevmapper real
ENV BUILDTAGS="containers_image_ostree_stub exclude_graphdriver_btrfs btrfs_noversion containers_image_openpgp seccomp selinux libdm_no_deferred_remove"

# Compilar con CGO para link estático contra libdevmapper de AlmaLinux
RUN mkdir -p /output && \
    CGO_ENABLED=1 GOFLAGS="-trimpath -mod=vendor" make binaries 2>&1 | tee /output/build.log

# Copiar binarios al directorio de salida
RUN cp bin/crio bin/pinns /output/ && ls -la /output/
RUN mkdir -p /output/etc/crio && \
    cp crio.conf /output/etc/crio/crio.conf.default
RUN ldd /output/crio 2>&1 | tee /output/ldd.log

FROM scratch
COPY --from=builder /output/ /
